# Public site. Next inlines NEXT_PUBLIC_* at BUILD time, so this value is baked
# into robots.txt and sitemap.xml — the wrangler.jsonc var cannot override it at
# runtime. Keep the dev value here; `npm run build:cloudflare` forces the
# production URL so a local build never ships localhost URLs to search engines.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Article drafting (Claude). Set in production with:
#   npx wrangler secret put ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# Contact form delivery
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@olgaemma.com
RESEND_TO_EMAIL=contact@olgaemma.com
